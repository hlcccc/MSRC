# Shell entry points run on Linux. Without this rule a Windows checkout with
# core.autocrlf=true writes CRLF into scripts/*.sh and bash fails with
# "$'\r': command not found" before the first line of real work.
*.sh text eol=lf

# Preserve upstream byte-identical whitespace for the SHA256-pinned safety head.
/references/plugguard/models.py text eol=lf -whitespace
/pipeline/plugguard.py text eol=lf
/pipeline/plugguard_report.py text eol=lf

# Preserve the audited experimental core byte-for-byte on every checkout.
/extensions/multilayer/frozen/** -text
/extensions/multilayer/runner.py text eol=lf
/extensions/__init__.py text eol=lf
/extensions/multilayer/__init__.py text eol=lf
/extensions/multilayer/tests/*.py text eol=lf
/resources/multilayer/*.json text eol=lf
/docs/FLOW_SAFETY_MULTILAYER.md text eol=lf
/docs/MULTILAYER_DELIVERY.md text eol=lf
/scripts/build_multilayer_doc.py text eol=lf
/scripts/build_multilayer_manifest.py text eol=lf
/extensions/multilayer/variants.py text eol=lf
/resources/multilayer/fitted/** text eol=lf
/docs/FLOW_SAFETY_MULTILAYER_*.md text eol=lf
/scripts/export_multilayer_state.py text eol=lf

# Portable transport recipes retain byte-identical notices and partition files.
/resources/reproduction/*_NOTICE.md text eol=lf
/resources/reproduction/raw_bundle.NOTICE.md text eol=lf
/resources/reproduction/prepared_partitions.sha256 text eol=lf
